FROM node:22-bookworm-slim AS dependencies

WORKDIR /app/BackEnd
COPY BackEnd/package*.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV PORT=3000
ENV DATABASE_PATH=/data/turnero.db

WORKDIR /app/BackEnd
COPY --from=dependencies /app/BackEnd/node_modules ./node_modules
COPY BackEnd/package*.json ./
COPY BackEnd/server.js BackEnd/seed-barbers.js ./

RUN mkdir -p /data && chown -R node:node /app /data
USER node

EXPOSE 3000
VOLUME ["/data"]
CMD ["sh", "-c", "node seed-barbers.js && node server.js"]